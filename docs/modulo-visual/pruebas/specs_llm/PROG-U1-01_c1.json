    "titulo": {
      "type": "string",
      "description": "Máximo 6 palabras"
    },
    "tipo_de_diagrama": {
      "enum": [
        "mapa_conceptual",
        "flujo",
        "comparacion",
        "linea_de_tiempo",
        "jerarquia",
        "ciclo",
        "causa_efecto"
      ]
    },
    "nodos": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "etiqueta"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^n[1-9]$"
          },
          "etiqueta": {
            "type": "string",
            "description": "Máximo 4 palabras"
          },
          "detalle": {
            "type": "string",
            "description": "Opcional, máximo 8 palabras. Solo lo usa el render determinístico"
          },
          "rol": {
            "enum": [
              "principal",
              "secundario",
              "resultado",
              "decision"
            ],
            "default": "secundario"
          },
          "grupo": {
            "type": "string",
            "description": "Columna en `comparacion`; marca temporal en `linea_de_tiempo`"
          }
        }
      }
    },
    "relaciones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "desde",
          "hacia",
          "verbo"
        ],
        "properties": {
          "desde": {
            "type": "string"
          },
          "hacia": {
            "type": "string"
          },
          "verbo": {
            "type": "string",
            "description": "Máximo 3 palabras"
          }
        }
      }
    },
    "paleta": {
      "enum": [
        "studify",
        "azul",
        "violeta"
      ]
    },
    "estilo": {
      "enum": [
        "plano"
      ]
    },
    "texto_alternativo": {
      "type": "string",
      "description": "1 o 2 oraciones que describen el diagrama"
    },
    "fuentes": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "id_fragmento usados"
    }
  },
