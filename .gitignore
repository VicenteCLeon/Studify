# Entorno
.env
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Datos locales (documentos fuente y respuestas del Google Forms no van al repo).
# Se usa data/* y no data/ porque git no permite re-incluir un archivo cuyo
# directorio padre está excluido: con data/ el .gitkeep nunca se versionaría.
data/*
!data/.gitkeep
# Artefactos de scripts/probar_perfiles_vark.py (cápsulas, prompts, WAV). Ya los
# cubre data/*, pero se declaran aparte para que no se versionen si alguien
# vuelve a incluir data/ completo.
data/pruebas_vark/
# Narraciones que genera el visor (hallazgo H10). Solo afecta a los WAV nuevos:
# capsula_620.wav y capsula_1451.wav siguen versionados hasta resolver H10.
src/studify/public/audio/*.wav
*.pdf
*.pptx
*.docx
respuestas_vark*.csv

# Editor / SO
# .vscode/ NO se ignora completo: settings.json y extensions.json se comparten para que
# cualquiera que clone el repo herede el intérprete de Python, ruff y pytest ya configurados.
# Solo se ignoran los archivos de estado personal (breakpoints, historial, etc.).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini

# Config local de Claude Code (permisos de esta sesión/máquina, no se comparte con el equipo)
.claude/settings.local.json
