# Copiar a .env y completar. El archivo .env NO se versiona.

# `dev` es el modo desarrollo: permite arrancar sin SESSION_SECRET (con uno
# efímero y un aviso) y con una clave de docente débil. Cualquier otro valor, o
# no fijarla, es producción: la app NO arranca sin un SESSION_SECRET de 32+
# caracteres ni con una TEACHER_PASSWORD débil. Fuera de `dev` la cookie lleva
# `Secure`, así que hay que servir la app por HTTPS (o desde localhost).
APP_ENV=dev

# --- Base de datos ---
# Opción A: Postgres vía Docker Compose (docker compose up -d)
DATABASE_URL=postgresql+psycopg://studify:studify@localhost:5432/studify
# Opción B: Postgres instalado nativamente en Windows (ajustar usuario/clave)
# DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/studify

# --- Sesión de la UI (Fase 4) ---
# Clave con la que se firman las cookies de sesión. Obligatoria fuera de
# APP_ENV=dev: 32 caracteres o más, aleatoria, distinta en cada máquina. En dev,
# si se deja vacía, la app genera una al arrancar, pero las sesiones se pierden
# en cada reinicio (y `uvicorn --reload` reinicia con cada guardado).
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Cuántas horas vale la sesión del estudiante desde que responde el cuestionario.
# 720 (30 días) para quien estudia en su propio equipo. En un computador
# compartido (laboratorio, pruebas de usuario) bajarla a 1–4, para que la sesión
# de uno no le quede abierta al siguiente. Pasado el plazo se vuelve a responder.
SESION_ESTUDIANTE_HORAS=720

# --- Acceso al panel del docente ---
# Usuario/clave únicos de /teacher/* (curación, analíticas y simulador). No hay
# tabla de usuarios ni valida contra la base de datos: el docente es un rol
# operativo del piloto, no una cuenta, y el panel tiene que poder abrirse aunque
# Postgres esté caído.
# La clave NO tiene valor por defecto: sin TEACHER_PASSWORD el panel queda
# CERRADO para todos —incluido el docente— y la pantalla de login lo dice. Esa
# puerta protege qué material llega a las cápsulas, y fallar abierto sería peor.
# Fuera de APP_ENV=dev la app no arranca con una clave débil (menos de 12
# caracteres o un valor conocido como admin123).
# Generar una con:  python -c "import secrets; print(secrets.token_urlsafe(18))"
TEACHER_USERNAME=admin
TEACHER_PASSWORD=

# --- Modelo de lenguaje ---
# Cualquier proveedor con API compatible con OpenAI. Se cambia de modelo sin tocar código.
#
# DeepSeek:  https://api.deepseek.com/v1          modelo: deepseek-flash
# Qwen:      https://dashscope-intl.aliyuncs.com/compatible-mode/v1   modelo: qwen-plus
# GLM/Zhipu: https://open.bigmodel.cn/api/paas/v4  modelo: glm-4-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# Razonamiento del modelo: disabled, enabled o vacío (no envía el parámetro).
# deepseek-flash razona por defecto y gasta ahí los tokens de la respuesta: con
# `disabled` genera la cápsula; sin él, llega truncada. Dejarlo vacío si el
# proveedor no reconoce el parámetro `thinking`.
LLM_THINKING=disabled
LLM_API_KEY=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=90
# Reintentos de red por llamada (timeout, conexión, 429, 5xx). Con 1, una
# llamada caída se intenta dos veces como máximo antes de mostrar el error.
LLM_MAX_RETRIES=1
# Reintentos del bucle de reparación cuando el JSON no pasa la validación estructural
LLM_MAX_REPAIR_ATTEMPTS=2

# --- Reglas de la microcápsula (cap. 11.1 del informe) ---
CAPSULA_MIN_PALABRAS=150
CAPSULA_MAX_PALABRAS=300
CAPSULA_MAX_PALABRAS_TITULO=10

# --- Base de conocimiento (Fase 2) ---
# Almacén de los documentos oficiales ingeridos. Se guardan nombrados por su
# SHA-256, así que la ruta sigue siendo válida aunque el docente mueva su copia.
# El directorio está en .gitignore: el material del curso no se versiona.
DOCUMENTOS_DIR=data/documentos
