# Copiar a .env y completar. El archivo .env NO se versiona.

APP_ENV=dev

# --- Base de datos ---
# Opción A: Postgres vía Docker Compose (docker compose up -d)
DATABASE_URL=postgresql+psycopg://studify:studify@localhost:5432/studify
# Opción B: Postgres instalado nativamente en Windows (ajustar usuario/clave)
# DATABASE_URL=postgresql+psycopg://postgres:TU_CLAVE@localhost:5432/studify

# --- Modelo de lenguaje ---
# Cualquier proveedor con API compatible con OpenAI. Se cambia de modelo sin tocar código.
#
# DeepSeek:  https://api.deepseek.com/v1          modelo: deepseek-chat
# Qwen:      https://dashscope-intl.aliyuncs.com/compatible-mode/v1   modelo: qwen-plus
# GLM/Zhipu: https://open.bigmodel.cn/api/paas/v4  modelo: glm-4-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=90
# Reintentos del bucle de reparación cuando el JSON no pasa la validación estructural
LLM_MAX_REPAIR_ATTEMPTS=2

# --- Reglas de la microcápsula (cap. 11.1 del informe) ---
CAPSULA_MIN_PALABRAS=150
CAPSULA_MAX_PALABRAS=300
CAPSULA_MAX_PALABRAS_TITULO=10

# --- Base de conocimiento (Fase 2) ---
# Almacén de los documentos oficiales ingeridos. Se guardan nombrados por su
# SHA-256, así que la ruta sigue siendo válida aunque el docente mueva su copia.
# El directorio está en .gitignore: el material del curso no se versiona.
DOCUMENTOS_DIR=data/documentos
